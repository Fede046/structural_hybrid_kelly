# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Unit-test / coverage
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# IDE and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Data directory (versionato solo il manifesto SHA256 dei CSV E0, T64)
data/raw/*
!data/raw/.gitkeep
!data/raw/E0/
data/raw/E0/*
!data/raw/E0/MANIFEST.sha256


# Agent files
.agent/*
!.agent/.gitkeep

docs/*
!docs/.gitkeep

# Uscite per seed di S10 (decisione S10), compresse e non versionate
results/raw/
